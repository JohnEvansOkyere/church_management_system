# Local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/church_cms

# Supabase on Render:
# Use the exact connection string from Supabase Dashboard -> Connect -> ORMs.
# Direct connection:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Shared pooler session mode, if direct IPv6 connectivity is not available:
# postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMS provider: arkesel or moolre (required before sending or running SMS reminders)
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=LivingSpring
ARKESEL_BASE_URL=https://sms.arkesel.com

MOOLRE_VAS_KEY=
MOOLRE_SENDER_ID=LivingSpring
MOOLRE_BASE_URL=https://api.moolre.com

# Comma-separated browser origins allowed to call the API (CORS).
# Local dev + your Vercel production and preview URLs, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app,https://your-app-git-main-org.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SENDGRID_API_KEY=
FROM_EMAIL=noreply@livingsspring.org

# Optional seed values (used by backend/scripts/seed_superadmin.py)
SUPERADMIN_EMAIL=admin@livingspring.org
SUPERADMIN_PASSWORD=ChangeMe123!
